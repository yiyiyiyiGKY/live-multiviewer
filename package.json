{
  "name": "live-multiviewer",
  "productName": "Live Multiviewer",
  "version": "0.1.0",
  "description": "可复用的导播多画面视频监看软件",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node scripts/start-native.js",
    "dev": "npm start",
    "legacy": "node scripts/develop.js",
    "build:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/build.ps1",
    "test:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/build.ps1 -Test",
    "package:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/package.ps1",
    "dev:web": "vite",
    "gateway": "node server/media-gateway.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "hls.js": "^1.7.2",
    "mpegts.js": "^1.8.2"
  }
}
